# Copy to .env  ->  cp .env.example .env
# Loaded by Next.js at runtime and by drizzle-kit for migrations.

# Local Postgres started by `pnpm db:up` (see docker-compose.yml)
DATABASE_URL=postgres://prep:prep@localhost:5432/prep

# Which data source the UI renders from:
#   memory   - throwaway synthetic seed, no database needed (default for `pnpm dev`)
#   database - the real student profile created by `pnpm prep:init`
# Unset = database in production (with a DATABASE_URL), memory otherwise.
APP_DATA_SOURCE=memory
