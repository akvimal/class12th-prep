# Copy to .env  ->  cp .env.example .env
# Loaded by Next.js at runtime and by drizzle-kit for migrations.

# Local Postgres started by `pnpm db:up` (see docker-compose.yml)
DATABASE_URL=postgres://prep:prep@localhost:5432/prep
# If 5432 is taken on your machine, pick another host port and match it above:
# DB_HOST_PORT=5433

# Which data source the UI renders from:
#   memory   - throwaway synthetic seed, no database needed (default for `pnpm dev`)
#   database - the real student profile created by `pnpm prep:init`
# Unset = database in production (with a DATABASE_URL), memory otherwise.
APP_DATA_SOURCE=memory

# Passcode lock. Leave PREP_PASSCODE unset to disable the gate (e.g. local dev).
#   PREP_PASSCODE         - the student passcode (full access). Plaintext, or
#                           PREP_PASSCODE_HASH for its SHA-256 hex.
#   PREP_PARENT_PASSCODE  - optional. A parent session limited to the /parent
#                           summary (also PREP_PARENT_PASSCODE_HASH).
# PREP_PASSCODE=student-code
# PREP_PARENT_PASSCODE=parent-code
# PREP_SESSION_SECRET=  # optional; a long random string. Derived from the passcode if unset.

# --- VPS deploy (docker compose --profile deploy) ---
# POSTGRES_PASSWORD=set-a-strong-one
# SITE_ADDRESS=board.example.com   # a domain for automatic HTTPS, or ":80" for plain HTTP / an IP
